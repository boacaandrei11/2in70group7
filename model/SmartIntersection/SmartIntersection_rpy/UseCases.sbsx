		<IUseCase type="e">
			<_id type="a">GUID 1acb0cc4-1335-431e-be0c-8771935b07dd</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">RunIntersection</_name>
			<_modifiedTimeWeak type="a">1.2.1990::0:0:0</_modifiedTimeWeak>
			<_theMainDiagram type="r">
				<IHandle type="e">
					<_hm2Class type="a">IUCDiagram</_hm2Class>
					<_hfilename type="a">.\UseCaseDiagrams.sbsx</_hfilename>
					<_hsubsystem type="a">UseCases::UseCaseDiagrams</_hsubsystem>
					<_hname type="a">SmartIntersectionUseCases</_hname>
					<_hid type="a">GUID 06bad11e-61a6-4b2e-b608-bf5f9ac9ef78</_hid>
				</IHandle>
			</_theMainDiagram>
			<_description type="p"><IDescription type="e">
				<_text type="a">Allows the ScenarioOperator to start and control an intersection simulation. SmartIntersectionCore advances the simulation clock, executes the traffic-signal phases and timing, and updates the behaviour and positions of vehicle and pedestrian agents according to the defined right-of-way rules. The operator can pause or reset the simulation and observe its resulting state through the Python dashboard.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">11.20.2026::13:47:24</_modifiedTime>
