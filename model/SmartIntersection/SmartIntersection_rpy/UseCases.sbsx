		<IUseCase type="e">
			<_id type="a">GUID ff6fb204-8d99-4e8b-8bb3-bd752539b20f</_id>
			<_myState type="a">8192</_myState>
			<_name type="a">ConfigureScenario</_name>
			<_modifiedTimeWeak type="a">1.2.1990::0:0:0</_modifiedTimeWeak>
			<_theMainDiagram type="r">
				<IHandle type="e">
					<_hm2Class type="a">IUCDiagram</_hm2Class>
					<_hfilename type="a">.\UseCaseDiagrams.sbsx</_hfilename>
					<_hsubsystem type="a">UseCases::UseCaseDiagrams</_hsubsystem>
					<_hname type="a">SmartIntersectionUseCases</_hname>
					<_hid type="a">GUID 06bad11e-61a6-4b2e-b608-bf5f9ac9ef78</_hid>
				</IHandle>
			</_theMainDiagram>
			<_description type="p"><IDescription type="e">
				<_text type="a">Allows the ScenarioOperator to configure the intersection simulation by selecting traffic scenarios, specifying the traffic population and road-user parameters, and requesting traffic-light timing plans. SmartIntersectionCore validates the requested configuration and confirms whether it is accepted or rejected. Valid timing changes requested during an active simulation are applied at a permitted phase boundary.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">11.20.2026::13:45:22</_modifiedTime>
			<weakCGTime type="a">1.2.1990::0:0:0</weakCGTime>
